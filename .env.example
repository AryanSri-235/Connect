# ---------------------------------------------------------------------------
# connect — environment
# Copy to `.env.local` for local dev. On Vercel, set these in Project Settings.
# Every value here is OPTIONAL for a first local run: with none of them set the
# app stores data in ./.data/connect.json and pulls GitHub via the public API.
# ---------------------------------------------------------------------------

# Postgres connection string. REQUIRED in production (Vercel's filesystem is
# read-only, so the JSON fallback cannot be used there).
# Neon:     postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Supabase: postgresql://postgres.xxx:pass@aws-0-region.pooler.supabase.com:6543/postgres
# Use the POOLED connection string — serverless functions open many short connections.
# keep Neon credentials secure: do not expose them to client-side code

DATABASE_URL='postgresql://neondb_owner:npg_tBajPxfG3o7F@ep-wandering-hall-axby8p3a-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require'

# GitHub personal access token (classic, no scopes needed for public data; or a
# fine-grained token with "Read access to public repositories").
# Without it the app falls back to the unauthenticated public-events API, which
# only reaches back ~90 days, is capped at 300 events, and allows 60 req/hour.
# With it you get the full contribution calendar (365 days, exact daily counts).
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=

# Shared password gating the whole site. The site ALWAYS asks for one: leave this
# empty and the first visitor is asked to choose it, and the hash is stored in the
# database. Set it here instead to fix the password at deploy time (this value
# always wins over whatever was chosen in the browser).
APP_PASSWORD='Aryika'

# Secret for the Vercel Cron endpoint (/api/cron). Vercel sends this automatically
# as `Authorization: Bearer $CRON_SECRET` when set in project env.
CRON_SECRET=

# IANA timezone deciding where one day ends and the next begins — this is what
# streaks are counted against. Falls back to UTC if unset (which is what Vercel
# runs in), so set it explicitly to the zone you two actually live in.
APP_TIMEZONE=Asia/Kolkata
